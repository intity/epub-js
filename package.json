{
  "name": "@intity/epub-js",
  "version": "0.3.96",
  "description": "Parse and Renderer EPUB containers",
  "main": "lib/index.js",
  "type": "module",
  "types": "types/index.d.ts",
  "module": "src/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intity/epub-js.git"
  },
  "bugs": {
    "url": "https://github.com/intity/epub-js/issues"
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "docs": "node docsgen.cjs",
    "lint": "eslint src",
    "test": "mocha",
    "dtsg": "npx -p typescript tsc",
    "start": "NODE_ENV=development webpack serve",
    "build": "NODE_ENV=production webpack --progress",
    "build2": "NODE_ENV=production TARGET=cjs webpack --progress",
    "minify": "NODE_ENV=production MINIMIZE=true webpack --progress",
    "compile": "babel -d lib/ src/",
    "prepare": "npm run compile && npm run build && npm run minify && npm run dtsg",
    "watch": "babel --watch -d lib/ src/"
  },
  "author": "fchasen@gmail.com",
  "license": "BSD-2-Clause",
  "contributors": [
    {
      "name": "vite",
      "email": "nuget@list.ru"
    }
  ],
  "dependencies": {
    "assert": "^2.1.0",
    "event-emitter": "^0.3.5",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "localforage": "^1.10.0",
    "lodash": "^4.18.1",
    "marked": "^18.0.7"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-export-default-from": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "core-js": "^3.49.0",
    "eslint": "^10.7.0",
    "jsdoc": "^4.0.5",
    "jsdoc-to-markdown": "^9.1.3",
    "mocha": "^11.7.6",
    "process": "^0.11.10",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^6.0.3",
    "webpack": "^5.109.0",
    "webpack-cli": "^7.2.1",
    "webpack-dev-middleware": "^8.0.4",
    "webpack-dev-server": "^5.2.6"
  },
  "allowScripts": {
    "core-js@3.49.0": true,
    "es5-ext@0.10.64": true
  }
}
